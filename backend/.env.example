# Copy this file to ".env" and adjust if needed.
# The .env file is git-ignored and never committed.

# Comma-separated list of frontend URLs allowed to call this API (CORS).
# Locally this is the Next.js dev server. Add your Vercel URL after deploying.
ALLOWED_ORIGINS=http://localhost:3000

# Folder where uploaded videos are stored (relative to backend/).
UPLOAD_DIR=data/uploads

# Folder where saved analysis results are stored.
ANALYSES_DIR=data/analyses
